{
  "name": "tryfolk-owned-dodo-target",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3300",
    "build": "tsx scripts/fingerprint.ts && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3300",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:repair": "tsx --test --test-skip-pattern='^fault control:' tests/*.test.ts regressions/*.test.ts",
    "repair:contract": "tsx scripts/repair-contract.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "dodopayments": "2.54.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
