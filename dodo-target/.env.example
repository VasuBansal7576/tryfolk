# Explicit LOCAL sandbox only. No production fixture auth or remote origin support.
TARGET_ENV=local
TARGET_SANDBOX=true
TARGET_MODE=healthy
TARGET_ORIGIN=http://127.0.0.1:3300
TARGET_DATABASE_PATH=./.data/healthy.sqlite
# Generate privately; never send this controller token to browser/model prompts.
TARGET_CONTROL_TOKEN=
# Primary-approved TEST MODE credentials, server-only. No secrets supplied yet.
# Write key: Customers Write + Checkout Sessions Write; all other resources None.
DODO_TEST_WRITE_KEY=
# Distinct verifier key: Checkout Sessions Read + Payments Read; all others None.
# No Write grants. Neither app key needs Products or Webhooks resource grants.
DODO_TEST_READ_KEY=
# Optional only after genuine signed-delivery setup is separately approved.
# Leave empty for app reconciliation; the webhook route then rejects with 503.
DODO_TEST_WEBHOOK_KEY=
DODO_TEST_PRODUCT_ID=
DODO_EXPECTED_AMOUNT_MINOR=
DODO_EXPECTED_CURRENCY=
# Set only after primary confirms dashboard Test Mode and granular key grants.
# These flags attest configuration; they do not prove provider access or delivery.
DODO_TEST_KEYS_CONFIRMED=false
DODO_READ_KEY_READ_ONLY=false
